# Optional — set APP_URL in Vercel to the production URL of the site
# (used for canonical/og:url meta tags). If unset, the current page URL is used.
APP_URL="https://your-domain.vercel.app"

# Required for the contact form (api/contact) — get a key at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Optional — sender address for contact emails. Must be a verified domain in Resend.
# Falls back to Resend's test sender (onboarding@resend.dev), which only delivers
# to the account owner's inbox.
RESEND_FROM_EMAIL="contact@your-domain.com"
